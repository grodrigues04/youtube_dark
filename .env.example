# Token da sua assinatura do Claude, gerado com: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-opus-5-5

# Mesmo MongoDB Atlas do market_trends (lê market_trends.researches, grava youtube_dark.videos)
MONGO_URI=

# YouTube: preenchidos por runner/auth_youtube.py (veja o README)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Hora (Brasília) em que o YouTube publica o Short do dia; ele sobe antes, privado e agendado
YOUTUBE_PUBLISH_HOUR=8

RENDER_CONCURRENCY=4
